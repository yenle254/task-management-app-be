# Production: Node.js 24 LTS. Development/test also supports Node 22.13.1+ (22.x).
# Copy locally to .env; never commit real secrets.
# Validate without connecting to services: npm run check:config
# For production set NODE_ENV=production and use the hosting provider's PORT.
PORT=3000
NODE_ENV=development
MONGO_URL=mongodb://127.0.0.1:27017/your_db_name
# Listen address is fixed to 0.0.0.0. Direct/local traffic: false.
# Behind a proxy: use verified proxy IP/CIDRs, or a verified fixed hop count.
# Do not assume Railway/Render always has one hop; see report/production-runtime.md.
TRUST_PROXY=false
# Public HTTPS backend origin for generated upload URLs behind a TLS ingress.
# Set on Railway/Render; independent of the IP/proxy trust policy.
# PUBLIC_BASE_URL=https://api.example.com
# Probe deadline (1-5000 ms) and total graceful shutdown budget (1-120000 ms).
HEALTHCHECK_TIMEOUT_MS=1000
SHUTDOWN_TIMEOUT_MS=15000
# Optional: debug, info, warn, error, silent. Default production level is info.
# LOG_LEVEL=info

# JWT & Refresh Token Configuration
# Supply at least 32 random bytes; example placeholders are rejected in production.
JWT_SECRET=
# JWT_EXPIRE is legacy-only; new access issuance always uses ACCESS_TOKEN_TTL <=15m.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
REFRESH_GRACE_SECONDS=60
JWT_ISSUER=taskflow-api
JWT_AUDIENCE=taskflow-client
REFRESH_ENABLED=true
# New deployments should not accept legacy tokens.
ACCEPT_LEGACY_TOKENS=false
# Only needed when ACCEPT_LEGACY_TOKENS=true: actual UTC rollout cutoff in the past.
# LEGACY_TOKEN_ISSUED_BEFORE=2026-11-07T23:59:59Z

# In production supply your actual allowed web origins, without paths/trailing slash.
# ALLOWED_ORIGINS is mandatory there; CLIENT_URL is only a development fallback.
# Native apps and server probes without an Origin header remain allowed.
CLIENT_URL=http://localhost:8081
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://10.0.2.2:8081

# Private files are mandatory in production. false permits development-only rollback on /uploads.
PRIVATE_FILES_ENABLED=true

# Optional Expo Push Notifications; leave empty until configured.
EXPO_ACCESS_TOKEN=

# Optional email: supply HOST, USER and PASS together to enable OTP email delivery.
# Current transporter uses STARTTLS (secure=false); use provider's STARTTLS port.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Cloudinary is optional in dev/test and required for production's persistent files.
# CLOUDINARY_ENABLED=false is development/test only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=taskflow_uploads

# Optional AI: local_only uses built-in rules without an external model.
# Production alternatives: gemini + GEMINI_API_KEY, or ollama + reachable OLLAMA_BASE_URL.
AI_PROVIDER=local_only
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# OLLAMA_BASE_URL=https://your-private-model-host.example
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_TIMEOUT_MS=25000

