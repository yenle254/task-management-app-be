# Copy locally to .env and supply your own secrets; never commit .env.
PORT=3000
NODE_ENV=development
MONGO_URL=mongodb://127.0.0.1:27017/your_db_name

# JWT & Refresh Token Configuration
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# JWT_EXPIRE is legacy-only; new access issuance always uses ACCESS_TOKEN_TTL <=15m.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
REFRESH_GRACE_SECONDS=60
JWT_ISSUER=taskflow-api
JWT_AUDIENCE=taskflow-client
REFRESH_ENABLED=true
# Only old id/iat/exp tokens issued before this UTC cutoff; max lifetime 7d.
# Set to your actual rollout time; do not keep extending this exception.
ACCEPT_LEGACY_TOKENS=true
LEGACY_TOKEN_ISSUED_BEFORE=2026-11-07T23:59:59Z

# Required in production; overrides the legacy CLIENT_URL alias. No wildcard in production.
CLIENT_URL=http://localhost:8081
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://10.0.2.2:8081

# Private files are mandatory in production. false permits development-only rollback on /uploads.
PRIVATE_FILES_ENABLED=true

# Expo Push Notifications
EXPO_ACCESS_TOKEN=your_expo_access_token_here

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=Task Management App <your_email@gmail.com>

# System Admin Initial Credentials
SYSTEM_ADMIN_EMAIL=admin@example.com
SYSTEM_ADMIN_PASSWORD=your_strong_admin_password

# Cloudinary Storage Configuration (Optional in dev/test, recommended for production)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

