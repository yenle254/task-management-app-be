{
  "openapi": "3.0.3",
  "info": {
    "title": "Task Review API",
    "version": "1.0.0",
    "description": "Task-wide review. Active current/snapshot Team Lead or HR may decide; assignees may never self-approve. Existing done tasks are preserved. Review writes use the shared task lock. SLA reminder is once per submission round after 24 hours."
  },
  "paths": {
    "/api/tasks/{id}/submit": {
      "post": {
        "tags": [
          "Tasks"
        ],
        "summary": "Submit task review",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "note": {
                    "type": "string",
                    "maxLength": 500
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated task",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/ReviewTask"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or blocked completion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewError"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden, including self-review",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewError"
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewError"
                }
              }
            }
          },
          "409": {
            "description": "Review changed or writes busy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewError"
                }
              }
            }
          }
        },
        "description": "Assignee only, from in_progress with all embedded subtasks complete. Children and dependencies may still be open at submission. If there is no active eligible approver, returns 409."
      }
    },
    "/api/tasks/{id}/approve": {
      "post": {
        "tags": [
          "Tasks"
        ],
        "summary": "Approve task review",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "note": {
                    "type": "string",
                    "maxLength": 500
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated task",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/ReviewTask"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or blocked completion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewError"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden, including self-review",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewError"
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewError"
                }
              }
            }
          },
          "409": {
            "description": "Review changed or writes busy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewError"
                }
              }
            }
          }
        },
        "description": "Only in_review tasks. Requires completed subtasks, children and dependencies. Self-approval returns 403, stale decision returns 409. PUT /api/tasks/{id}/status with done delegates to these same guards."
      }
    },
    "/api/tasks/{id}/request-changes": {
      "post": {
        "tags": [
          "Tasks"
        ],
        "summary": "Request changes task review",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  }
                },
                "required": [
                  "reason"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Updated task",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/ReviewTask"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or blocked completion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewError"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden, including self-review",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewError"
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewError"
                }
              }
            }
          },
          "409": {
            "description": "Review changed or writes busy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewError"
                }
              }
            }
          }
        }
      }
    },
    "/api/tasks/{id}/withdraw": {
      "post": {
        "tags": [
          "Tasks"
        ],
        "summary": "Withdraw task review",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Updated task",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/ReviewTask"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or blocked completion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewError"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden, including self-review",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewError"
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewError"
                }
              }
            }
          },
          "409": {
            "description": "Review changed or writes busy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewError"
                }
              }
            }
          }
        }
      }
    },
    "/api/tasks/pending-approval": {
      "get": {
        "tags": [
          "Tasks"
        ],
        "summary": "Review inbox",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "teamId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "overdueSla",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Scoped pending approvals or pending/overdueSla/byTeam statistics",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ReviewTask"
                      }
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "total": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "page": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "pages": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Not a task approver",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewError"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query, identifiers, note or reason",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewError"
                }
              }
            }
          }
        }
      }
    },
    "/api/tasks/pending-approval/stats": {
      "get": {
        "tags": [
          "Tasks"
        ],
        "summary": "Review inbox statistics",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "teamId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "overdueSla",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Scoped pending approvals or pending/overdueSla/byTeam statistics",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/ReviewStats"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Not a task approver",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewError"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query, identifiers, note or reason",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ReviewEvent": {
        "type": "object",
        "properties": {
          "round": {
            "type": "integer",
            "minimum": 0
          },
          "type": {
            "type": "string",
            "enum": [
              "submitted",
              "approved",
              "changes_requested",
              "withdrawn",
              "reassigned",
              "cancelled"
            ]
          },
          "by": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "_id": {
                    "type": "string"
                  },
                  "profile": {
                    "type": "object",
                    "properties": {
                      "fullName": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            ],
            "nullable": true
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "note": {
            "type": "string",
            "maxLength": 500
          },
          "reason": {
            "type": "string",
            "maxLength": 1000
          }
        }
      },
      "TaskReview": {
        "type": "object",
        "properties": {
          "submittedBy": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "_id": {
                    "type": "string"
                  },
                  "profile": {
                    "type": "object",
                    "properties": {
                      "fullName": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            ],
            "nullable": true
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "note": {
            "type": "string",
            "maxLength": 500
          },
          "currentRound": {
            "type": "integer",
            "minimum": 0
          },
          "remindedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "approverSnapshot": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "userId": {
                  "type": "string"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "team_lead",
                    "hr_manager"
                  ]
                },
                "resolvedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "active": {
                  "type": "boolean"
                }
              }
            }
          },
          "rounds": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReviewEvent"
            }
          }
        }
      },
      "ReviewTask": {
        "type": "object",
        "description": "Normal enriched task fields plus review state. Legacy tasks return empty review rounds.",
        "properties": {
          "_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "todo",
              "in_progress",
              "in_review",
              "done",
              "deleted"
            ]
          },
          "review": {
            "$ref": "#/components/schemas/TaskReview"
          }
        }
      },
      "ReviewStats": {
        "type": "object",
        "properties": {
          "pending": {
            "type": "integer",
            "minimum": 0
          },
          "overdueSla": {
            "type": "integer",
            "minimum": 0
          },
          "byTeam": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "teamId": {
                  "type": "string"
                },
                "teamName": {
                  "type": "string"
                },
                "pending": {
                  "type": "integer",
                  "minimum": 0
                },
                "overdueSla": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      },
      "ReviewError": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
